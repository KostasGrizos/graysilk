{
  "name": "@graysilk/ui",
  "version": "0.3.0",
  "private": true,
  "description": "GraySilk brand React components (Platform Edge). Source package for Vite apps.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./map": "./src/map/index.ts",
    "./map.css": "./src/map/map.css"
  },
  "scripts": {
    "playground": "vite playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "maplibre-gl": ">=5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "maplibre-gl": "5.24.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pixelarticons": "2.4.2"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  }
}
