{
  "name": "@kostasgrizos/graysilk-ui",
  "version": "0.6.0",
  "description": "GraySilk React components: tokens, buttons, cards, loaders, status, charts and an OSM map theme.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KostasGrizos/graysilk.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/types/map/index.d.ts",
      "import": "./dist/map.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./map.css": "./dist/map.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "playground": "vite playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5",
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "pixelarticons": "2.4.2",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "maplibre-gl": "5.24.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "@types/geojson": "7946.0.16"
  }
}
